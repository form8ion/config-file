{
  "name": "@form8ion/config-file",
  "description": "form8ion utility for managing RC files",
  "license": "MIT",
  "version": "0.0.0-semantically-released",
  "type": "commonjs",
  "author": "Matt Travi <npm@travi.org> (https://matt.travi.org)",
  "repository": "form8ion/config-file",
  "bugs": "https://github.com/form8ion/config-file/issues",
  "homepage": "https://npm.im/@form8ion/config-file",
  "runkitExampleFilename": "./example.js",
  "exports": {
    "require": "./lib/index.js",
    "import": "./lib/index.mjs"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "sideEffects": false,
  "scripts": {
    "test": "npm-run-all --print-label build --parallel lint:* --parallel test:*",
    "build:js": "rollup --config",
    "watch": "run-s 'build:js -- --watch'",
    "clean": "rimraf ./lib",
    "prebuild": "run-s clean",
    "build": "npm-run-all --print-label --parallel build:*",
    "prepack": "run-s build",
    "test:unit": "cross-env NODE_ENV=test c8 run-s test:unit:base",
    "test:unit:base": "DEBUG=any vitest run",
    "lint:lockfile": "lockfile-lint",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "run-s 'lint:js -- --fix'",
    "lint:md": "remark . --frail",
    "generate:md": "remark . --output",
    "pregenerate:md": "run-s build",
    "lint:sensitive": "ban",
    "prepare": "husky install",
    "lint:peer": "npm ls >/dev/null",
    "lint:gherkin": "gherkin-lint",
    "pretest:integration:base": "run-s build",
    "test:integration": "run-s 'test:integration:base -- --profile noWip'",
    "test:integration:base": "NODE_OPTIONS=--enable-source-maps DEBUG=any cucumber-js test/integration --profile base",
    "test:integration:debug": "DEBUG=test run-s test:integration",
    "test:integration:wip": "run-s 'test:integration:base -- --profile wip'",
    "test:integration:wip:debug": "DEBUG=test run-s 'test:integration:wip'",
    "test:integration:focus": "run-s 'test:integration:base -- --profile focus'",
    "lint:publish": "publint --strict"
  },
  "files": [
    "example.js",
    "lib/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "npm@12.2.3+sha512.a2f98d4517bbe89bdca7513a88e78f43a1fd66be1730eaea81f69e18d86d46f3f75d29762e8fdaf42d4de7f8d194b2ebb2a09e9bfa268067591e96796baca7d5",
  "dependencies": {
    "@form8ion/core": "^4.2.0",
    "cosmiconfig": "^10.0.0"
  },
  "devDependencies": {
    "@babel/register": "7.29.13",
    "@cucumber/cucumber": "12.9.0",
    "@form8ion/babel-preset": "1.6.156",
    "@form8ion/commitlint-config": "3.0.3",
    "@form8ion/eslint-config": "7.0.18",
    "@form8ion/eslint-config-cucumber": "1.4.1",
    "@form8ion/remark-lint-preset": "6.0.7",
    "@rollup/plugin-babel": "7.1.0",
    "@travi/any": "3.3.0",
    "babel-plugin-istanbul": "8.0.0",
    "ban-sensitive-files": "1.10.11",
    "c8": "12.0.0",
    "cross-env": "10.1.0",
    "cz-conventional-changelog": "3.3.0",
    "gherkin-lint": "4.2.4",
    "husky": "9.1.7",
    "jest-when": "4.0.3",
    "js-yaml": "5.5.0",
    "lockfile-lint": "5.1.0",
    "mock-fs": "5.5.0",
    "npm-run-all2": "9.1.0",
    "publint": "0.3.25",
    "remark-cli": "12.0.1",
    "remark-toc": "9.0.0",
    "remark-usage": "11.0.1",
    "rimraf": "6.1.4",
    "rollup": "4.68.8",
    "rollup-plugin-auto-external": "2.0.0",
    "vitest": "5.1.1"
  }
}
